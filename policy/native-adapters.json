{
  "schemaVersion": 1,
  "namespace": "scopegrain-",
  "activation": "manual-review-only",
  "writeHostRoots": false,
  "installHooks": false,
  "installPlugins": false,
  "readOnlyAgentIds": [
    "architect",
    "security-auditor",
    "researcher",
    "reviewer",
    "harness-maintainer",
    "requirements-analyst",
    "release-engineer"
  ],
  "hosts": {
    "claude": {
      "skillRoot": ".claude/skills",
      "commandFormat": "skill",
      "agentRoot": ".claude/agents",
      "agentFormat": "markdown",
      "commandFrontmatter": "disable-model-invocation: true\n",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "tools:\n  - Read\n  - Grep\n  - Glob\n",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "Selected read-only agent tools only; not path isolation or MCP authentication.",
      "sources": [
        "https://code.claude.com/docs/en/skills",
        "https://code.claude.com/docs/en/sub-agents"
      ]
    },
    "codex": {
      "skillRoot": ".agents/skills",
      "commandFormat": "skill",
      "agentRoot": ".codex/agents",
      "agentFormat": "toml-with-declarations",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "sandbox_mode = \"read-only\"\n",
      "invocation": "$scopegrain-NAME",
      "permissionScope": "Read-only filesystem role sandbox; does not certify MCP side effects or network denial.",
      "sources": [
        "https://github.com/openai/codex/blob/main/codex-rs/ext/skills/src/host_roots.rs",
        "https://github.com/openai/codex/blob/main/codex-rs/agent-roles/src/loader.rs",
        "https://github.com/openai/codex/blob/main/codex-rs/core/src/agent/role_tests.rs"
      ]
    },
    "opencode": {
      "skillRoot": ".opencode/skills",
      "commandRoot": ".opencode/commands",
      "commandFormat": "markdown",
      "agentRoot": ".opencode/agents",
      "agentFormat": "markdown",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "Variant-specific permission proposals; choose V1 or V2 after checking the host version. No runtime enforcement is certified.",
      "sources": [
        "https://opencode.ai/docs/commands/",
        "https://opencode.ai/docs/agents/",
        "https://opencode.ai/docs/mcp-servers/"
      ]
    },
    "devin": {
      "skillRoot": ".devin/skills",
      "commandFormat": "skill",
      "agentRoot": ".devin/agents",
      "agentFormat": "markdown",
      "commandFrontmatter": "triggers:\n  - user\n",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "allowed-tools:\n  - read\n  - grep\n  - glob\n",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "Custom subagent tool allowlist only; inline skill allowed-tools means auto-approval, not restriction.",
      "sources": [
        "https://docs.devin.ai/cli/extensibility/skills/creating-skills.md",
        "https://docs.devin.ai/cli/subagents.md"
      ]
    },
    "antigravity": {
      "skillRoot": ".agents/skills",
      "commandFormat": "skill",
      "agentRoot": ".agents/agents",
      "agentFormat": "markdown",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "Variant selection required. Shared .agents paths are not host isolation. No native runtime has been certified.",
      "sources": [
        "https://antigravity.google/docs/skills",
        "https://antigravity.google/docs/subagents",
        "https://antigravity.google/docs/mcp"
      ]
    },
    "copilot": {
      "skillRoot": ".agents/skills",
      "commandFormat": "skill",
      "agentRoot": ".github/agents",
      "agentFormat": "markdown",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "scopegrain-NAME",
      "permissionScope": "Shared .agents skill shadow plus .github custom-agent profiles; the documented agent 'tools' list is not certified here, so no restriction is requested.",
      "sources": [
        "https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/add-skills",
        "https://docs.github.com/en/copilot/how-tos/copilot-cli/use-copilot-cli/invoke-custom-agents",
        "https://docs.github.com/en/copilot/reference/custom-agents-configuration",
        "https://code.visualstudio.com/docs/copilot/customization/mcp-servers"
      ]
    },
    "cursor": {
      "skillRoot": ".cursor/skills",
      "commandFormat": "skill",
      "agentRoot": ".cursor/agents",
      "agentFormat": "markdown",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "readonly: true\n",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "Subagent 'readonly' blocks edits and state-changing shell commands but MCP tools still inherit from the parent; it is not a tool allowlist.",
      "sources": [
        "https://cursor.com/docs/skills",
        "https://cursor.com/docs/subagents",
        "https://cursor.com/docs/rules",
        "https://cursor.com/docs/mcp"
      ]
    },
    "cline": {
      "skillRoot": ".cline/skills",
      "commandFormat": "skill",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "No agent bridges emitted: Cline subagent definitions are .yaml files under .cline/agents (CLI/Desktop only, not the VS Code extension) and the format is not projected. No tool restriction is requested anywhere else.",
      "sources": [
        "https://docs.cline.bot/customization/skills",
        "https://docs.cline.bot/getting-started/config",
        "https://github.com/cline/cline/blob/main/docs/customization/cline-rules.mdx",
        "https://github.com/cline/cline/blob/main/docs/mcp/mcp-overview.mdx"
      ]
    },
    "roo": {
      "skillRoot": ".roo/skills",
      "commandRoot": ".roo/commands",
      "commandFormat": "markdown",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "No agent bridges emitted: Roo custom modes are YAML settings, not per-agent markdown files — no documented .md agent root exists. No tool restriction is requested.",
      "sources": [
        "https://github.com/RooCodeInc/Roo-Code/blob/main/apps/docs/docs/features/skills.mdx",
        "https://roocodeinc.github.io/Roo-Code/features/mcp/using-mcp-in-roo/",
        "https://github.com/RooCodeInc/Roo-Code/blob/main/apps/docs/docs/features/custom-instructions.md",
        "https://github.com/RooCodeInc/Roo-Code/pull/6263"
      ]
    },
    "kilo": {
      "skillRoot": ".kilo/skills",
      "commandRoot": ".kilo/commands",
      "commandFormat": "markdown",
      "agentRoot": ".kilo/agents",
      "agentFormat": "markdown",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "Agent 'mode'/'permission' fields are documented but no restriction proposal is certified; none is emitted. Legacy .kilocode/ roots are backward-compat surfaces, not the primary adapter target.",
      "sources": [
        "https://kilo.ai/docs/customize/skills",
        "https://kilo.ai/docs/customize/workflows",
        "https://kilo.ai/docs/customize/custom-modes",
        "https://kilo.ai/docs/customize/custom-subagents",
        "https://kilo.ai/docs/customize/custom-rules",
        "https://kilo.ai/docs/automate/mcp/using-in-kilo-code"
      ]
    },
    "gemini-cli": {
      "skillRoot": ".gemini/skills",
      "commandRoot": ".gemini/commands",
      "commandFormat": "toml",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "No agent bridges emitted: Gemini CLI has no documented project-level custom-agent markdown root. Workspace skills require a trusted folder. MCP 'trust' is never set — server approval stays interactive.",
      "sources": [
        "https://geminicli.com/docs/cli/using-agent-skills/",
        "https://geminicli.com/docs/cli/custom-commands/",
        "https://geminicli.com/docs/cli/gemini-md/",
        "https://geminicli.com/docs/tools/mcp-server/"
      ]
    },
    "windsurf": {
      "skillRoot": ".windsurf/skills",
      "commandRoot": ".windsurf/workflows",
      "commandFormat": "markdown",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "/scopegrain-NAME",
      "permissionScope": "Legacy Cascade surface (.windsurf/); Devin Desktop's Devin Local harness reads .devin/ roots already covered by the devin adapter. No .windsurf/agents root is documented — no agent bridges emitted. No tool restriction is requested.",
      "sources": [
        "https://docs.windsurf.com/windsurf/cascade/skills.md",
        "https://docs.devin.ai/cli/reference/configuration/read-config-from",
        "https://docs.windsurf.com/llms.txt"
      ]
    },
    "generic": {
      "skillRoot": ".agent/skills",
      "commandFormat": "skill",
      "agentRoot": ".agent/agents",
      "agentFormat": "markdown",
      "commandFrontmatter": "",
      "agentFrontmatter": "",
      "readOnlyAgentFrontmatter": "",
      "invocation": "workflow NAME",
      "permissionScope": "Generic host conventions (.agent/ roots, plain markdown). Not certified against any specific product; a scaffold for hosts without a dedicated adapter.",
      "sources": [
        "https://github.com/github/spec-kit"
      ]
    }
  }
}
