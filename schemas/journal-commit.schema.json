{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scopegrain journal commit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "intentDigest", "state", "confirmedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"const": "committed"},
    "confirmedAt": {
      "type": "string",
      "description": "Canonical Date.toISOString value, validated at runtime."
    }
  },
  "description": "Runtime validates the operation and intent digest against the stored intent."
}
