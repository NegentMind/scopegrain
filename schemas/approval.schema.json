{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:scopegrain:approval:v1",
  "title":"Content-bound approval record",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","id","revision","target","status","question","notice","scope","options","createdAt","updatedAt","history"],
  "properties":{
    "schemaVersion":{"const":1},
    "id":{"$ref":"#/$defs/digest"},
    "revision":{"$ref":"#/$defs/revision"},
    "target":{"$ref":"#/$defs/target"},
    "status":{"enum":["pending","approved","rejected","declined","needs-clarification","revoked"]},
    "question":{"$ref":"#/$defs/text"},
    "notice":{"$ref":"#/$defs/text"},
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["paths","effects"],
      "properties":{
        "paths":{"type":"array","items":{"$ref":"#/$defs/text"}},
        "effects":{"const":["permit-next-harness-gate-for-bound-content"]}
      }
    },
    "options":{
      "type":"array","minItems":2,"maxItems":2,
      "prefixItems":[
        {
          "type":"object","additionalProperties":false,
          "required":["id","label","description"],
          "properties":{"id":{"const":"approve"},"label":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"}}
        },
        {
          "type":"object","additionalProperties":false,
          "required":["id","label","description"],
          "properties":{"id":{"const":"reject"},"label":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"}}
        }
      ],
      "items":false
    },
    "createdAt":{"$ref":"#/$defs/time"},
    "updatedAt":{"$ref":"#/$defs/time"},
    "history":{
      "type":"array","minItems":1,
      "prefixItems":[{"$ref":"#/$defs/createdEvent"}],
      "items":{"$ref":"#/$defs/answeredEvent"}
    }
  },
  "$defs":{
    "text":{"type":"string","pattern":"\\S","description":"Non-empty after trimming; runtime rejects whitespace-only strings."},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "uuid":{"type":"string","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "revision":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "time":{"type":"string","format":"date-time","description":"Runtime requires canonical ISO UTC roundtrip and chronological consistency."},
    "target":{
      "oneOf":[
        {
          "type":"object","additionalProperties":false,"required":["kind","artifactKind","id","digest"],
          "properties":{"kind":{"const":"artifact"},"artifactKind":{"enum":["spec","design","research","report","review","decision","lesson","handoff"]},"id":{"$ref":"#/$defs/uuid"},"digest":{"$ref":"#/$defs/digest"}}
        },
        {
          "type":"object","additionalProperties":false,"required":["kind","id","digest"],
          "properties":{"kind":{"const":"task"},"id":{"$ref":"#/$defs/uuid"},"digest":{"$ref":"#/$defs/digest"}}
        },
        {
          "type":"object","additionalProperties":false,"required":["kind","id","digest"],
          "properties":{"kind":{"const":"plan"},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},"digest":{"$ref":"#/$defs/digest"}}
        }
      ]
    },
    "createdEvent":{
      "type":"object","additionalProperties":false,
      "required":["at","event","revision","status","actor","answer","comment"],
      "properties":{
        "at":{"$ref":"#/$defs/time"},
        "event":{"const":"created"},
        "revision":{"const":0},
        "status":{"const":"pending"},
        "actor":{"type":"null"},
        "answer":{"type":"null"},
        "comment":{"type":"null"}
      }
    },
    "answeredEvent":{
      "type":"object","additionalProperties":false,
      "required":["at","event","revision","status","actor","answer","comment"],
      "properties":{
        "at":{"$ref":"#/$defs/time"},
        "event":{"const":"answered"},
        "revision":{"$ref":"#/$defs/revision"},
        "status":{"enum":["approved","rejected","declined","needs-clarification","revoked"]},
        "actor":{"$ref":"#/$defs/text"},
        "answer":{"enum":["approve","reject","decline","custom","revoke"]},
        "comment":{"oneOf":[{"type":"null"},{"type":"string"}]}
      },
      "allOf":[
        {"if":{"properties":{"answer":{"const":"approve"}},"required":["answer"]},"then":{"properties":{"status":{"const":"approved"}}}},
        {"if":{"properties":{"answer":{"const":"reject"}},"required":["answer"]},"then":{"properties":{"status":{"const":"rejected"}}}},
        {"if":{"properties":{"answer":{"const":"decline"}},"required":["answer"]},"then":{"properties":{"status":{"const":"declined"}}}},
        {"if":{"properties":{"answer":{"const":"custom"}},"required":["answer"]},"then":{"properties":{"status":{"const":"needs-clarification"},"comment":{"type":"string","pattern":"\\S"}}}},
        {"if":{"properties":{"answer":{"const":"revoke"}},"required":["answer"]},"then":{"properties":{"status":{"const":"revoked"}}}}
      ]
    }
  },
  "description":"Runtime additionally checks ID/filename/target digest agreement, chronological/history invariants (history length equals revision+1, per-index revisions, nondecreasing times, createdAt/updatedAt/status mirroring the first/last event), revoke only out of approved, non-empty comment on custom answers and on every re-answer after pending, option uniqueness, canonical scope paths, current target and byte/event limits. Actor identity and evidence are not authenticated."
}
