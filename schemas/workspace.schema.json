{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scopegrain workspace identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "workspaceId", "projectId", "repositoryId",
    "revision", "createdAt", "updatedAt", "areas"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workspaceId": {"$ref": "#/$defs/uuid"},
    "projectId": {"$ref": "#/$defs/uuid"},
    "repositoryId": {"$ref": "#/$defs/uuid"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "updatedAt": {"$ref": "#/$defs/timestamp"},
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "name"],
        "properties": {
          "id": {"$ref": "#/$defs/uuid"},
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "description": "Canonical Date.toISOString value; chronology is validated at runtime."
    }
  },
  "description": "Runtime also enforces unique identities and area keys, canonical timestamps, chronology and document size."
}
