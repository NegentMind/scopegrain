{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scopegrain selective capture note",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "revision", "category", "title", "summary", "scope", "provenance", "subjectId", "supersedes", "capturedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "scopegrain.capture"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "revision": {"const": 0},
    "category": {"enum": ["decision", "event", "attempt", "discard", "preference", "tool", "skill", "stack", "lesson", "rule"]},
    "title": {"type": "string", "pattern": "\\S"},
    "summary": {"type": "string", "pattern": "\\S"},
    "scope": {"$ref": "#/$defs/scope"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "origin"],
      "properties": {
        "basis": {"enum": ["declared", "inferred"]},
        "origin": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
      }
    },
    "subjectId": {"type": ["string", "null"], "pattern": "\\S"},
    "supersedes": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "capturedAt": {"type": "string", "description": "Canonical Date.toISOString, validated at runtime; capture time, not proof of event occurrence time."}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "projectId", "repositoryId", "areaIds"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/uuid"},
        "projectId": {"$ref": "#/$defs/uuid"},
        "repositoryId": {"$ref": "#/$defs/uuid"},
        "areaIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"category": {"const": "preference"}}},
    "then": {"properties": {"subjectId": {"type": "string", "pattern": "\\S"}}}
  }],
  "description": "Immutable attributed assertion, not authenticated identity, verified activity, an active-preference resolver or a workflow approval."
}
