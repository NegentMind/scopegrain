{
  "name": "scopegrain",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "npm@11.6.0",
  "description": "Project-neutral engineering harness for coding agents",
  "keywords": [
    "agent",
    "coding-agent",
    "harness",
    "workflow",
    "tasks",
    "mcp",
    "journal",
    "verification"
  ],
  "author": "The Negent Mind Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NegentMind/scopegrain.git"
  },
  "bugs": "https://github.com/NegentMind/scopegrain/issues",
  "homepage": "https://github.com/NegentMind/scopegrain#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "scopegrain": "bin/scopegrain.mjs"
  },
  "files": [
    "bin",
    "src",
    "resources",
    "policy",
    "templates",
    "schemas",
    "docs/*.md",
    "docs/en/*.md",
    "viewer/dist",
    "examples",
    "CHANGELOG.md",
    "AUTHORS",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:fast": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:smoke": "node --test --test-concurrency=2 tests/cli.test.mjs tests/config.test.mjs tests/paths.test.mjs tests/tasks.test.mjs tests/plans.test.mjs tests/journal.test.mjs tests/methodology-gates.test.mjs tests/api-server.test.mjs tests/mcp.test.mjs tests/docs-cli-drift.test.mjs tests/structure.test.mjs tests/activity.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 tests/*.test.mjs",
    "test:eval": "node --test tests/eval/",
    "test:eval:record": "node tests/eval/run-scenarios.mjs --record",
    "build:viewer": "npm --prefix viewer run build",
    "prepack": "npm run build:viewer && npm test"
  },
  "mcpName": "io.github.negentmind/scopegrain",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "zod": "4.5.4"
  }
}
